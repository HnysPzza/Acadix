# Acadix — Firebase configuration
#
# IMPORTANT: this file documents the settings the app needs. It is NOT read at runtime.
# Android apps have no process environment variables, so on-device the values must come from
# Configuration/FirebaseSettings.local.cs (copy FirebaseSettings.local.example.cs and fill it
# in). That file is git-ignored.
#
# These names are also read via Environment.GetEnvironmentVariable, which is only useful for
# desktop/Windows debugging where you can set real environment variables.

ACADIX_FIREBASE_PROJECT_ID=your-firebase-project-id
ACADIX_FIREBASE_WEB_API_KEY=your-firebase-web-api-key
ACADIX_FIRESTORE_DATABASE_ID=(default)

# Must be an Android-type OAuth client ID (not a Web client), because Google sign-in uses a
# custom-scheme redirect: com.companyname.acadsjulie://auth
ACADIX_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
