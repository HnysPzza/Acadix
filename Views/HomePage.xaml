<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcadsJulie.Views.HomePage"
             BackgroundColor="{StaticResource MobileCanvas}"
             Shell.NavBarIsVisible="False">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero Header with Gradient -->
            <Grid HeightRequest="245">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource GradStart}" Offset="0"/>
                            <GradientStop Color="{StaticResource GradMid}" Offset="0.62"/>
                            <GradientStop Color="{StaticResource GradEnd}" Offset="1"/>
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <!-- Decorative circles -->
                <Ellipse WidthRequest="180" HeightRequest="180"
                         HorizontalOptions="End" VerticalOptions="Start"
                         Margin="0,-50,-60,0" Opacity="0.15">
                    <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
                </Ellipse>
                <Ellipse WidthRequest="120" HeightRequest="120"
                         HorizontalOptions="End" VerticalOptions="End"
                         Margin="0,0,-20,30" Opacity="0.1">
                    <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
                </Ellipse>

                <!-- Header Content -->
                <Grid Padding="24,50,24,24" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="GreetingLabel"
                               Text="{Binding Greeting}"
                               TextColor="White" FontSize="14" Opacity="0.9"/>
                        <Label x:Name="NameLabel"
                               Text="{Binding UserName}"
                               TextColor="White" FontSize="26" FontAttributes="Bold"/>
                        <Label Text="Ready to train your brain today?"
                               TextColor="White" FontSize="13" Opacity="0.8" Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                    
                    <Grid HorizontalOptions="End" VerticalOptions="Start" WidthRequest="40" HeightRequest="40"
                          Margin="0,-5,0,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}"/>
                        </Grid.GestureRecognizers>
                        <Label Text="🔔" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        
                        <!-- Notification Badge -->
                        <Ellipse WidthRequest="12" HeightRequest="12" Fill="#FF3366" 
                                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0"
                                 IsVisible="{Binding HasUnreadNotifications}"/>
                    </Grid>
                </Grid>

                <!-- Brain Score + Streak floating card -->
                <Border Margin="16,0,16,0" VerticalOptions="End" HorizontalOptions="Fill"
                        Style="{StaticResource ModernCardBorder}" Padding="20,16">
                    <Grid ColumnDefinitions="*,1,*">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding BrainScore}" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource MobilePrimary}" HorizontalOptions="Center"/>
                            <Label Text="🧠 Brain Score" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <BoxView Grid.Column="1" BackgroundColor="{StaticResource Gray200}" WidthRequest="1" HeightRequest="50" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding StreakDays}" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center">
                                <Label.TextColor><Color>#FF9A3C</Color></Label.TextColor>
                            </Label>
                            <Label Text="🔥 Day Streak" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Daily Challenge Banner — Border supports gestures correctly -->
            <Border Margin="16,20,16,0" Padding="0"
                    StrokeShape="RoundRectangle 20"
                    Stroke="Transparent"
                    Shadow="{Shadow Brush=Black, Opacity=0.14, Radius=16}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToChallengeCommand}"/>
                </Border.GestureRecognizers>
                <Grid>
                    <BoxView InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFB347" Offset="0"/>
                                <GradientStop Color="#FF6B6B" Offset="1"/>
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <Ellipse WidthRequest="100" HeightRequest="100" InputTransparent="True"
                             HorizontalOptions="End" VerticalOptions="Center"
                             Margin="0,0,-30,0" Opacity="0.2">
                        <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
                    </Ellipse>
                    <HorizontalStackLayout Padding="20,16" Spacing="12" InputTransparent="True">
                        <Label Text="⚡" FontSize="30" VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                            <Label Text="Daily Challenge" TextColor="White" FontSize="12" Opacity="0.9"/>
                            <Label x:Name="ChallengeTitleLabel" Text="{Binding ChallengeTitle}"
                                   TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Label Text="›" TextColor="White" FontSize="24" VerticalOptions="Center" Opacity="0.8"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Daily Study Quote Card -->
            <Border x:Name="QuoteCard" Margin="16,16,16,0" Padding="16"
                    StrokeShape="RoundRectangle 16" Stroke="Transparent"
                    BackgroundColor="{StaticResource MobileSurfaceRaised}"
                    Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=12}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="💭" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label x:Name="QuoteTextLabel" 
                               Text="The beautiful thing about learning is that no one can take it away from you."
                               FontSize="14" 
                               FontAttributes="Italic"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"/>
                        <Label x:Name="QuoteAuthorLabel" 
                               Text="— B.B. King"
                               FontSize="11" 
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="End"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Quick Study Timer -->
            <Border x:Name="TimerCard" Margin="16,16,16,0" Padding="16"
                    StrokeShape="RoundRectangle 16" Stroke="Transparent"
                    BackgroundColor="{StaticResource MobilePrimaryDark}"
                    Shadow="{Shadow Brush=Black, Opacity=0.12, Radius=12}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="⏱️ Focus Timer" FontSize="12" TextColor="#DCE7FF" FontAttributes="Bold"/>
                        <Label x:Name="TimerDisplayLabel" 
                               Text="25:00" 
                               FontSize="32" 
                               FontAttributes="Bold"
                               TextColor="White"
                               FontFamily="SpaceMono"/>
                        <Label x:Name="TimerStatusLabel" 
                               Text="Ready to focus?" 
                               FontSize="12" 
                               TextColor="White"
                               Opacity="0.8"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button x:Name="StartTimerButton"
                                Text="▶ Start"
                                Clicked="OnStartTimerClicked"
                                BackgroundColor="White"
                                TextColor="{StaticResource MobilePrimaryDark}"
                                CornerRadius="12"
                                HeightRequest="44"
                                WidthRequest="100"
                                FontAttributes="Bold"
                                FontSize="13"/>
                        <Button x:Name="StopTimerButton"
                                Text="⏹ Stop"
                                Clicked="OnStopTimerClicked"
                                BackgroundColor="#FFFFFF33"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="36"
                                WidthRequest="100"
                                FontAttributes="Bold"
                                FontSize="12"
                                IsVisible="False"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Weekly Progress Summary -->
            <Border x:Name="WeeklyProgressCard" Margin="16,16,16,0" Padding="16"
                    StrokeShape="RoundRectangle 16" Stroke="Transparent"
                    BackgroundColor="{StaticResource MobileSurface}"
                    Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=12}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="📊 This Week's Progress" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label x:Name="WeekComparisonLabel" Text="↑ +12% vs last week" FontSize="{StaticResource TextLabel}" TextColor="{StaticResource StateSuccessOnLight}" FontAttributes="Bold" Grid.Column="1"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label x:Name="WeekStudyDaysLabel" Text="5" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource MobilePrimary}" HorizontalOptions="Center"/>
                            <Label Text="Study Days" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                            <Label x:Name="WeekTasksLabel" Text="12" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource StateSuccessOnLight}" HorizontalOptions="Center"/>
                            <Label Text="Tasks Done" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                            <Label x:Name="WeekXPLabel" Text="340" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource StateWarningOnLight}" HorizontalOptions="Center"/>
                            <Label Text="XP Earned" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Mini progress bars -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="44,*,52" ColumnSpacing="8">
                            <Label x:Name="WeekDay1Label" Text="--" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Start" VerticalOptions="Center"/>
                            <ProgressBar x:Name="WeekDay1Progress" Grid.Column="1" Progress="0" ProgressColor="{StaticResource MobilePrimary}" HeightRequest="4" VerticalOptions="Center"/>
                            <Label x:Name="WeekDay1PercentLabel" Grid.Column="2" Text="0%" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="44,*,52" ColumnSpacing="8">
                            <Label x:Name="WeekDay2Label" Text="--" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Start" VerticalOptions="Center"/>
                            <ProgressBar x:Name="WeekDay2Progress" Grid.Column="1" Progress="0" ProgressColor="{StaticResource StateSuccess}" HeightRequest="4" VerticalOptions="Center"/>
                            <Label x:Name="WeekDay2PercentLabel" Grid.Column="2" Text="0%" FontSize="{StaticResource TextCaption}" TextColor="{StaticResource StateSuccessOnLight}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="44,*,52" ColumnSpacing="8">
                            <Label x:Name="WeekDay3Label" Text="--" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Start" VerticalOptions="Center"/>
                            <ProgressBar x:Name="WeekDay3Progress" Grid.Column="1" Progress="0" ProgressColor="{StaticResource MobilePrimary}" HeightRequest="4" VerticalOptions="Center"/>
                            <Label x:Name="WeekDay3PercentLabel" Grid.Column="2" Text="0%" FontSize="10" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Skill Categories Header -->
            <Label Text="Skill Categories" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" Margin="20,24,20,8"/>

            <!-- 2x2 + Knowledge Grid of category cards -->
            <Grid Margin="16,0,16,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="12">

                <!-- Memory Card -->
                <Border Grid.Row="0" Grid.Column="0" Padding="0"
                        StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        Shadow="{Shadow Brush=Black, Opacity=0.12, Radius=18}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToGameCommand}"
                            CommandParameter="Games/CardMatch" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <BoxView InputTransparent="True">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4361EE" Offset="0"/>
                                    <GradientStop Color="#3A86FF" Offset="1"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                        <VerticalStackLayout Padding="16" Spacing="6" InputTransparent="True">
                            <Label Text="🧠" FontSize="32"/>
                            <Label Text="Memory" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                            <Label x:Name="MemoryScoreLabel" Text="{Binding MemoryScore}" TextColor="White" FontSize="11" Opacity="0.85"/>
                            <Border BackgroundColor="#33FFFFFF" Padding="6,3" StrokeShape="RoundRectangle 10" Stroke="Transparent" HorizontalOptions="Start">
                                <Label Text="Easy" TextColor="White" FontSize="10"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Focus Card -->
                <Border Grid.Row="0" Grid.Column="1" Padding="0"
                        StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        Shadow="{Shadow Brush=Black, Opacity=0.12, Radius=18}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToGameCommand}"
                            CommandParameter="Games/OddOneOut" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <BoxView InputTransparent="True">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#06D6A0" Offset="0"/>
                                    <GradientStop Color="#0EE9B0" Offset="1"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                        <VerticalStackLayout Padding="16" Spacing="6" InputTransparent="True">
                            <Label Text="🎯" FontSize="32"/>
                            <Label Text="Focus" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                            <Label x:Name="FocusScoreLabel" Text="{Binding FocusScore}" TextColor="White" FontSize="11" Opacity="0.85"/>
                            <Border BackgroundColor="#33FFFFFF" Padding="6,3" StrokeShape="RoundRectangle 10" Stroke="Transparent" HorizontalOptions="Start">
                                <Label Text="Easy" TextColor="White" FontSize="10"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Logic Card -->
                <Border Grid.Row="1" Grid.Column="0" Padding="0"
                        StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        Shadow="{Shadow Brush=Black, Opacity=0.12, Radius=18}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToGameCommand}"
                            CommandParameter="Games/Sequence" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <BoxView InputTransparent="True">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#9D4EDD" Offset="0"/>
                                    <GradientStop Color="#7B2FBE" Offset="1"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                        <VerticalStackLayout Padding="16" Spacing="6" InputTransparent="True">
                            <Label Text="🧩" FontSize="32"/>
                            <Label Text="Logic" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                            <Label x:Name="LogicScoreLabel" Text="{Binding LogicScore}" TextColor="White" FontSize="11" Opacity="0.85"/>
                            <Border BackgroundColor="#33FFFFFF" Padding="6,3" StrokeShape="RoundRectangle 10" Stroke="Transparent" HorizontalOptions="Start">
                                <Label Text="Easy" TextColor="White" FontSize="10"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Speed Card -->
                <Border Grid.Row="1" Grid.Column="1" Padding="0"
                        StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        Shadow="{Shadow Brush=Black, Opacity=0.12, Radius=18}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToGameCommand}"
                            CommandParameter="Games/QuickMath" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <BoxView InputTransparent="True">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF9A3C" Offset="0"/>
                                    <GradientStop Color="#FF6B6B" Offset="1"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                        <VerticalStackLayout Padding="16" Spacing="6" InputTransparent="True">
                            <Label Text="⚡" FontSize="32"/>
                            <Label Text="Speed" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                            <Label x:Name="SpeedScoreLabel" Text="{Binding SpeedScore}" TextColor="White" FontSize="11" Opacity="0.85"/>
                            <Border BackgroundColor="#33FFFFFF" Padding="6,3" StrokeShape="RoundRectangle 10" Stroke="Transparent" HorizontalOptions="Start">
                                <Label Text="Easy" TextColor="White" FontSize="10"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Knowledge Card -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Padding="0"
                        StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        Shadow="{Shadow Brush=Black, Opacity=0.12, Radius=18}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToTriviaCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <BoxView InputTransparent="True">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3D5A80" Offset="0"/>
                                    <GradientStop Color="#98C1D9" Offset="1"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                        <HorizontalStackLayout Padding="20,16" Spacing="16" VerticalOptions="Center">
                            <Label Text="📚" FontSize="40"/>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Knowledge" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                                <Label Text="{Binding KnowledgeScore}" TextColor="White" FontSize="12" Opacity="0.9"/>
                                <Label Text="Answer trivia across History, Science, Math &amp; more" TextColor="White" FontSize="11" Opacity="0.8"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bookmark Quick Access -->
            <Border x:Name="BookmarksCard" Margin="16,16,16,0" Padding="16"
                    StrokeShape="RoundRectangle 16" Stroke="Transparent"
                    BackgroundColor="{StaticResource MobileSurface}"
                    Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=12}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="🔖 Quick Bookmarks" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Button Text="See all" Clicked="OnViewAllBookmarksClicked" 
                                BackgroundColor="Transparent" TextColor="{StaticResource MobilePrimary}" 
                                FontSize="12" Padding="0" HeightRequest="30" Grid.Column="1"/>
                    </Grid>
                    <CollectionView x:Name="BookmarksCollection" HeightRequest="80" 
                                    ItemsLayout="HorizontalList" 
                                    EmptyView="No bookmarks yet. Save content from the library!">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource MobilePrimaryMuted}" 
                                        Stroke="Transparent" 
                                        StrokeShape="RoundRectangle 18" 
                                        Padding="12,8" 
                                        Margin="0,0,8,0"
                                        WidthRequest="140">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBookmarkTapped" CommandParameter="{Binding Id}"/>
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding IconEmoji}" FontSize="20" HorizontalOptions="Center"/>
                                        <Label Text="{Binding Title}" FontSize="11" FontAttributes="Bold" 
                                               TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Daily Check-in -->
            <Border x:Name="CheckInCard" Margin="16,16,16,0" Padding="16"
                    StrokeShape="RoundRectangle 16" Stroke="Transparent"
                    BackgroundColor="{StaticResource MobilePrimaryMuted}"
                    Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=12}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Label Text="📅" FontSize="32" VerticalOptions="Start"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label x:Name="CheckInStatusLabel" Text="Daily Check-in" FontSize="16" FontAttributes="Bold" TextColor="#166534"/>
                        <Label x:Name="CheckInStreakLabel" Text="🔥 5 day streak! Keep it up!" FontSize="{StaticResource TextLabel}" TextColor="{StaticResource StateSuccessOnLight}" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                    <Button x:Name="CheckInButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="Check In"
                            Clicked="OnCheckInClicked"
                            BackgroundColor="{StaticResource MobilePrimary}"
                            TextColor="White"
                            CornerRadius="18"
                            HeightRequest="44"
                            MinimumWidthRequest="116"
                            HorizontalOptions="Start"
                            FontAttributes="Bold"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Quick Notes - Minimal Modern Design -->
            <Border x:Name="QuickNotesCard" Margin="16,16,16,0" Padding="20"
                    StrokeShape="RoundRectangle 20" Stroke="Transparent"
                    BackgroundColor="{StaticResource MobileSurface}"
                    Shadow="{Shadow Brush=Black, Opacity=0.06, Radius=16}">
                <VerticalStackLayout Spacing="12">
                    <!-- Header Row -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border BackgroundColor="{StaticResource MobilePrimaryMuted}" 
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 14"
                                Padding="8"
                                WidthRequest="36" HeightRequest="36">
                            <Label Text="✏️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Quick Note" 
                               FontSize="15" 
                               FontAttributes="Bold" 
                               TextColor="#1A1A2E"
                               VerticalOptions="Center"
                               Grid.Column="1"
                               Margin="10,0,0,0"/>
                        <Label x:Name="SavedNotesCountLabel"
                               Text="0 saved"
                               FontSize="12"
                               TextColor="#6B7280"
                               VerticalOptions="Center"
                               Grid.Column="2"/>
                    </Grid>

                    <!-- Input Area -->
                    <Border BackgroundColor="{StaticResource MobileSurfaceRaised}" 
                            Stroke="{StaticResource MobileStroke}"
                            StrokeShape="RoundRectangle 18"
                            Padding="14,12">
                        <Editor x:Name="QuickNoteEditor"
                               Placeholder="What's on your mind?"
                               PlaceholderColor="#9CA3AF"
                               HeightRequest="50"
                               FontSize="14"
                               BackgroundColor="Transparent"
                               TextColor="#1A1A2E"/>
                    </Border>

                    <!-- Action Row -->
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="Auto-saves to device" 
                                   FontSize="11" 
                                   TextColor="#9CA3AF"/>
                            <Label Text="•" FontSize="11" TextColor="#D1D5DB"/>
                            <Label x:Name="LastNoteTimeLabel"
                                   Text="just now"
                                   FontSize="11"
                                   TextColor="#9CA3AF"/>
                        </HorizontalStackLayout>
                        <Button Text="Save" 
                                Clicked="OnSaveQuickNoteClicked"
                                BackgroundColor="{StaticResource MobilePrimary}"
                                TextColor="White"
                                CornerRadius="16"
                                HeightRequest="36"
                                WidthRequest="70"
                                FontSize="13"
                                FontAttributes="Bold"
                                Padding="0"
                                Grid.Column="1"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Recent Activity -->
            <Label Text="Recent Activity" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" Margin="20,24,20,8"/>

            <Border Margin="16,0,16,24" Padding="20,16"
                    Style="{StaticResource ModernCardBorder}">
                <VerticalStackLayout x:Name="RecentActivityStack" Spacing="12">
                    <Label Text="No games played yet. Start training! 🚀"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="14" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

    <Border x:Name="XpToast"
            IsVisible="False"
            Opacity="0"
            TranslationY="-18"
            BackgroundColor="{StaticResource MobileSuccess}"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 18"
            Padding="14,8"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,54,0,0"
            Shadow="{Shadow Brush=Black, Opacity=0.16, Radius=14}">
        <Label x:Name="XpToastLabel"
               Text="+10 XP"
               TextColor="White"
               FontSize="15"
               FontAttributes="Bold"/>
    </Border>
    </Grid>
</ContentPage>
