<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AcadsJulie.ViewModels"
             x:Class="AcadsJulie.Views.TriviaSetupPage"
             x:Name="SetupPage"
             x:DataType="viewmodels:TriviaSetupViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource MobileCanvas}">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource MobileCanvas}" Offset="0"/>
                    <GradientStop Color="{StaticResource MobileCanvasDeep}" Offset="1"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView Grid.RowSpan="2">
            <VerticalStackLayout Spacing="18" Padding="20,50,20,32">
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                    <Button Grid.Column="0" Text="←" FontSize="20" FontAttributes="Bold"
                            BackgroundColor="{StaticResource MobileSurfaceRaised}" TextColor="{StaticResource TextPrimary}"
                            CornerRadius="18" WidthRequest="44" HeightRequest="44"
                            Command="{Binding GoBackCommand}"/>
                    <Label Grid.Column="1" Text="Knowledge Quiz Setup"
                           Style="{StaticResource HeadlineLabel}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <Border Style="{StaticResource ModernCardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Select Category" Style="{StaticResource HeadlineLabel}" />
                        <CollectionView ItemsSource="{Binding Fields}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:TriviaChoice">
                                    <Border Style="{StaticResource ChoiceChipBorder}" Padding="12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectFieldCommand, Source={x:Reference SetupPage}}"
                                                                  CommandParameter="{Binding Key}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryMuted}" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                            </DataTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="History" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="#FFF7D6" />
                                                <Setter Property="Stroke" Value="#F59E0B" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="Math" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="#DBEEFF" />
                                                <Setter Property="Stroke" Value="#2563EB" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="Science" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                <Setter Property="Stroke" Value="#16A34A" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="Space" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="#EDE9FE" />
                                                <Setter Property="Stroke" Value="#7C3AED" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="Biology" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="#E0F2FE" />
                                                <Setter Property="Stroke" Value="#0891B2" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="Animals" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="#FFE4E6" />
                                                <Setter Property="Stroke" Value="#E11D48" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="Geography" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                <Setter Property="Stroke" Value="#15803D" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="Computers" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="#E0F2FE" />
                                                <Setter Property="Stroke" Value="#0369A1" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="Mythology" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="#EDE9FE" />
                                                <Setter Property="Stroke" Value="#6D28D9" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="Border">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding Key}" Value="General" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryMuted}" />
                                                <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                            </MultiTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Text="{Binding Icon}" FontSize="18" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ModernCardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Scope" Style="{StaticResource HeadlineLabel}" />
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding ShowHistoryScope}">
                            <Border Style="{StaticResource ChoiceChipBorder}" Padding="12,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectSubFieldCommand}" CommandParameter="WorldHistory" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedSubField}" Value="WorldHistory">
                                        <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryMuted}" />
                                        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="World History" />
                            </Border>
                            <Border Style="{StaticResource ChoiceChipBorder}" Padding="12,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectSubFieldCommand}" CommandParameter="PhilippineHistory" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedSubField}" Value="PhilippineHistory">
                                        <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryMuted}" />
                                        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Philippine History" />
                            </Border>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding ShowAnimalScope}">
                            <Border Style="{StaticResource ChoiceChipBorder}" Padding="12,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectSubFieldCommand}" CommandParameter="Land" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedSubField}" Value="Land">
                                        <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryMuted}" />
                                        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Land" />
                            </Border>
                            <Border Style="{StaticResource ChoiceChipBorder}" Padding="12,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectSubFieldCommand}" CommandParameter="Sea" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedSubField}" Value="Sea">
                                        <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryMuted}" />
                                        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Sea" />
                            </Border>
                            <Border Style="{StaticResource ChoiceChipBorder}" Padding="12,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectSubFieldCommand}" CommandParameter="Air" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedSubField}" Value="Air">
                                        <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryMuted}" />
                                        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Air" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ModernCardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Difficulty" Style="{StaticResource HeadlineLabel}" />
                        <CollectionView ItemsSource="{Binding Difficulties}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:TriviaChoice">
                                    <Border Style="{StaticResource ChoiceChipBorder}" Padding="14,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectDifficultyCommand, Source={x:Reference SetupPage}}"
                                                                  CommandParameter="{Binding Key}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource MobilePrimaryMuted}" />
                                                <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <HorizontalStackLayout>
                                            <Label Text="{Binding Icon}" />
                                            <Label Text="{Binding Title}" Margin="6,0,0,0" FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding SelectedSummary}"
                       Style="{StaticResource CalloutLabel}"
                       HorizontalTextAlignment="Center"
                       Margin="0,4,0,0"/>

                <!--
                    Warn before the player commits. These categories have no local questions,
                    so offline they would hit a dead end after tapping Start.
                -->
                <Border IsVisible="{Binding IsOnlineOnlyCategory}"
                        BackgroundColor="{StaticResource MobileAmberMuted}"
                        Stroke="{StaticResource MobileAmber}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,10"
                        Margin="0,2,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="📶"
                               FontSize="{StaticResource TextBody}"
                               VerticalOptions="Start"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Needs internet"
                                   FontFamily="{StaticResource FontHeading}"
                                   FontSize="{StaticResource TextCallout}"
                                   TextColor="{StaticResource MobileAmberOnLight}"/>
                            <Label Text="This category has no offline questions. Pick History, Science or General to play without a connection."
                                   Style="{StaticResource CaptionLabel}"
                                   TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="{Binding SourceSummary}"
                       Style="{StaticResource CaptionLabel}"
                       IsVisible="{Binding ShowSourceSummary}"
                       HorizontalTextAlignment="Center"
                       Margin="16,0"/>

                <Border x:Name="StartQuizCta" Style="{StaticResource PrimaryCtaBorder}" Margin="0,8,0,0" Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStartQuizTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="Start Quiz" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,16" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
