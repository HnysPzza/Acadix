<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcadsJulie.Views.QuestClaimModalPage"
             BackgroundColor="#B3000000">

    <Grid>
        <!-- Background tap to dismiss -->
        <BoxView BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Modal Box -->
        <Frame x:Name="ModalFrame" VerticalOptions="Center" HorizontalOptions="Center"
               WidthRequest="320" Padding="0" CornerRadius="24"
               BackgroundColor="{StaticResource MobileSurface}" HasShadow="True"
               Scale="0.8" Opacity="0">
               
            <VerticalStackLayout Spacing="0">
                <!-- Header with Icon -->
                <Grid HeightRequest="140" BackgroundColor="{StaticResource MobilePrimary}">
                    <Ellipse WidthRequest="200" HeightRequest="200" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.1" Fill="White"/>
                    <Label Text="🏆" FontSize="64" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,10"/>
                </Grid>

                <VerticalStackLayout Padding="24" Spacing="16" HorizontalOptions="Center">
                    <Label Text="Quest Completed!" TextColor="{StaticResource TextPrimary}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
                    
                    <Label x:Name="QuestTitleLabel" Text="Quest Title" TextColor="{StaticResource TextSecondary}" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Frame BackgroundColor="{StaticResource MobilePrimaryMuted}" CornerRadius="18" Padding="16,12" HasShadow="False" BorderColor="Transparent" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="✨" FontSize="20" VerticalOptions="Center"/>
                            <Label x:Name="RewardLabel" Text="+100 XP" TextColor="{StaticResource MobilePrimaryDark}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>

                    <Frame x:Name="BadgeFrame" IsVisible="False" BackgroundColor="{StaticResource MobileCoralMuted}" CornerRadius="18" Padding="16,12" HasShadow="False" BorderColor="Transparent" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="🏅" FontSize="20" VerticalOptions="Center"/>
                            <Label x:Name="BadgeLabel" Text="Achieved!" TextColor="{StaticResource MobileCoral}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>

                    <Button Text="Awesome!"
                            BackgroundColor="{StaticResource MobilePrimary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="20"
                            HeightRequest="48"
                            Margin="0,16,0,0"
                            Clicked="OnCloseTapped"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
