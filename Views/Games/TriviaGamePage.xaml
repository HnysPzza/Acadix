<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AcadsJulie.ViewModels"
             xmlns:controls="clr-namespace:AcadsJulie.Controls"
             xmlns:ske="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI.Maui"
             x:Class="AcadsJulie.Views.Games.TriviaGamePage"
             x:DataType="viewmodels:TriviaViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#101427">

    <Grid>
        <Grid x:Name="BackgroundLayer">
            <BoxView x:Name="BackgroundGradient">
                <BoxView.Background>
                    <LinearGradientBrush x:Name="GradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource GradStart}" Offset="0"/>
                        <GradientStop Color="{StaticResource GradEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            <ske:SKLottieView x:Name="MascotLottie"
                              Source="parrot_idle.json"
                              RepeatCount="-1"
                              RepeatMode="Restart"
                              HeightRequest="220"
                              WidthRequest="220"
                              Opacity="0.14"
                              HorizontalOptions="End"
                              VerticalOptions="End"
                              Margin="0,0,-20,-30" />
            <Ellipse WidthRequest="200" HeightRequest="200" HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-50,-60,0" Opacity="0.1">
                <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid RowDefinitions="Auto,*">
            <VerticalStackLayout Grid.Row="0" Spacing="16" Padding="20,40,20,10">
                <Grid ColumnDefinitions="Auto,*">
                    <Button Grid.Column="0" Text="←" FontSize="20" FontAttributes="Bold"
                            BackgroundColor="#22FFFFFF" TextColor="White"
                            CornerRadius="18" WidthRequest="44" HeightRequest="44"
                            Clicked="OnBackClicked"/>
                    <Label x:Name="TitleLabel" Grid.Column="1" Text="📚 Trivia" TextColor="White" 
                           FontSize="20" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <Border x:Name="ScoreCard"
                        Padding="12,9"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#2EFFFFFF"
                        Stroke="#44FFFFFF"
                        StrokeThickness="1"
                        MinimumHeightRequest="66">
                    <Grid ColumnDefinitions="1.35*,*,*" ColumnSpacing="10">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="1">
                            <Label Text="{Binding ScoreDisplay}"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"/>
                            <Label Grid.Row="1"
                                   Text="Score"
                                   TextColor="#D7E5E2"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   MaxLines="1"/>
                        </Grid>

                        <BoxView Grid.Column="1"
                                 WidthRequest="1"
                                 BackgroundColor="#33FFFFFF"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Fill"/>
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="1" Padding="8,0,0,0">
                            <Label Text="{Binding RoundDisplay}"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   MaxLines="1"/>
                            <Label Grid.Row="1"
                                   Text="Round"
                                   TextColor="#D7E5E2"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   MaxLines="1"/>
                        </Grid>

                        <BoxView Grid.Column="2"
                                 WidthRequest="1"
                                 BackgroundColor="#33FFFFFF"
                                 HorizontalOptions="Start"
                                 VerticalOptions="Fill"/>
                        <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="1" Padding="8,0,0,0">
                            <Label Text="{Binding Streak}"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   MaxLines="1"/>
                            <Label Grid.Row="1"
                                   Text="Streak"
                                   TextColor="#D7E5E2"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   MaxLines="1"/>
                        </Grid>
                    </Grid>
                </Border>

                <ProgressBar Progress="{Binding RoundProgress}" x:Name="ProgressBarControl" BackgroundColor="#33FFFFFF" ProgressColor="#FFB347" HeightRequest="6"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="0" Padding="20,10,20,34" VerticalOptions="Center">
                <!-- Parrot Host -->
                <Grid x:Name="ParrotHostSection" ColumnDefinitions="2*,3*" ColumnSpacing="12" Margin="0,0,0,20">
                    <Border Grid.Column="0"
                            Padding="6"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="#FFFFFFFF"
                            Stroke="#E5E5E5"
                            StrokeThickness="1"
                            VerticalOptions="End">
                        <!-- Literal default matches Resources/Raw; code-behind sets SKFileLottieImageSource for reliable load -->
                        <ske:SKLottieView x:Name="ParrotHostLottie"
                                          Source="parrot_idle.json"
                                          RepeatCount="-1"
                                          RepeatMode="Restart"
                                          HeightRequest="160"
                                          WidthRequest="160"
                                          HorizontalOptions="Center"
                                          VerticalOptions="End" />
                    </Border>

                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                        <Path x:Name="SpeechBubbleTail"
                              Grid.Column="0"
                              Data="M 20,10 L 0,20 L 20,30 Z"
                              Fill="#FFFFFF"
                              Stroke="#E5E5E5"
                              StrokeThickness="2"
                              WidthRequest="20"
                              HeightRequest="40"
                              HorizontalOptions="Start"
                              VerticalOptions="Center"
                              Margin="0,0,-1,0" />

                        <Border x:Name="SpeechBubbleBorder"
                                Grid.Column="1"
                                BackgroundColor="#FFFFFF"
                                Stroke="#E5E5E5"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 18"
                                VerticalOptions="Center"
                                HeightRequest="-1"
                                Padding="16,14">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="{Binding CurrentQuestionText}"
                                       TextColor="#1A1A2E"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"/>
                                <controls:RingTimerControl HeightRequest="70"
                                                           WidthRequest="70"
                                                           HorizontalOptions="Center"
                                                           MaxTime="{Binding MaxTime}"
                                                           TimeLeft="{Binding TimeLeft}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="OptionsGrid"
                      RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="14"
                      ColumnSpacing="14"/>
            </VerticalStackLayout>
        </Grid>

        <BoxView x:Name="FeedbackFlash" IsVisible="False" Opacity="0" BackgroundColor="#3306D6A0"/>

        <Grid IsVisible="{Binding IsGameOver}" x:Name="GameOverOverlay" BackgroundColor="#B3000000" Opacity="0">
            <Border x:Name="GameOverCard" Margin="40" Padding="30" VerticalOptions="Center"
                    StrokeShape="RoundRectangle 16" BackgroundColor="#22FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Game Over!" TextColor="White" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="{Binding Score, StringFormat='Score: {0}'}" x:Name="FinalScoreLabel" TextColor="#06D6A0" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                    <VerticalStackLayout>
                        <Label Text="Streak" TextColor="#B0B0CC" FontSize="14" HorizontalOptions="Center"/>
                        <Label Text="{Binding Streak}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Border Stroke="{StaticResource MobileSuccess}" StrokeThickness="2" StrokeShape="RoundRectangle 20" BackgroundColor="#2206D6A0" Margin="0,10,0,0">
                        <Button Text="Play Again" TextColor="White" FontSize="16" FontAttributes="Bold" BackgroundColor="Transparent" Command="{Binding RestartGameCommand}" Padding="0,14"/>
                    </Border>
                    <Button Text="Back to Menu" TextColor="#B0B0CC" FontSize="14" BackgroundColor="Transparent" Clicked="OnBackClicked"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
