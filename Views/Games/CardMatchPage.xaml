<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AcadsJulie.ViewModels"
             xmlns:models="clr-namespace:AcadsJulie.Models"
             x:Class="AcadsJulie.Views.Games.CardMatchPage"
             x:DataType="viewmodels:CardMatchViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource DarkSurface}">

    <ContentPage.Resources>
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#22FFFFFF" />
            <Setter Property="Stroke" Value="#33FFFFFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="16" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- Background Gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource GradStart}" Offset="0"/>
                    <GradientStop Color="{StaticResource GradEnd}" Offset="1"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Decorative circles -->
        <Ellipse WidthRequest="200" HeightRequest="200"
                 HorizontalOptions="End" VerticalOptions="Start"
                 Margin="0,-50,-60,0" Opacity="0.1">
            <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
        </Ellipse>

        <Grid RowDefinitions="Auto, *">
            
            <!-- Top Bar / HUD -->
            <VerticalStackLayout Grid.Row="0" Spacing="16" Padding="20,40,20,20">
                <Grid ColumnDefinitions="Auto, *">
                    <Button Grid.Column="0" Text="←" FontSize="20" FontAttributes="Bold"
                            BackgroundColor="#22FFFFFF" TextColor="White"
                            CornerRadius="18" WidthRequest="44" HeightRequest="44"
                            Clicked="OnBackClicked"/>
                    <Label Grid.Column="1" Text="Card Match" TextColor="White" 
                           FontSize="20" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="12,8">
                        <VerticalStackLayout>
                            <Label Text="Moves" TextColor="#B0B0CC" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="{Binding Moves}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="12,8">
                        <VerticalStackLayout>
                            <Label Text="Pairs" TextColor="#B0B0CC" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="{Binding MatchedPairs, StringFormat='{0}/8'}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="12,8">
                        <VerticalStackLayout>
                            <Label Text="Time" TextColor="#B0B0CC" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="{Binding TimeLeft}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar Progress="{Binding MatchedPairs}" BackgroundColor="#33FFFFFF" ProgressColor="{StaticResource MobileSuccess}" HeightRequest="6"/>
            </VerticalStackLayout>

            <!-- Card Grid -->
            <ScrollView Grid.Row="1" VerticalOptions="Center" Padding="20,0,20,40">
                <!-- Using FlexLayout or Grid to display items -->
                <Grid RowSpacing="12" ColumnSpacing="12" x:Name="CardGrid"
                      HorizontalOptions="Center" VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Extra row for HARD -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollView>

        </Grid>

        <!-- Result Overlay -->
        <Grid IsVisible="{Binding IsGameOver}" BackgroundColor="#B3000000">
            <Border Style="{StaticResource GlassCardStyle}" Margin="40" Padding="30" VerticalOptions="Center">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Game Over!" TextColor="White" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="{Binding Score, StringFormat='Score: {0}'}" TextColor="{StaticResource MobileSuccess}" FontSize="36" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Moves" TextColor="#B0B0CC" FontSize="14" HorizontalOptions="Center"/>
                            <Label Text="{Binding Moves}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Time Left" TextColor="#B0B0CC" FontSize="14" HorizontalOptions="Center"/>
                            <Label Text="{Binding TimeLeft, StringFormat='{0}s'}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Border Stroke="{StaticResource MobileSuccess}" StrokeThickness="2" StrokeShape="RoundRectangle 20" BackgroundColor="#2206D6A0" Margin="0,10,0,0">
                        <Button Text="Play Again" TextColor="White" FontSize="16" FontAttributes="Bold" BackgroundColor="Transparent" Command="{Binding RestartGameCommand}" Padding="0,14" Clicked="OnPlayAgainClicked"/>
                    </Border>
                    <Button Text="Back to Menu" TextColor="#B0B0CC" FontSize="14" BackgroundColor="Transparent" Clicked="OnBackClicked"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
