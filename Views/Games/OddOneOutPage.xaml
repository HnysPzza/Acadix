<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AcadsJulie.ViewModels"
             xmlns:controls="clr-namespace:AcadsJulie.Controls"
             x:Class="AcadsJulie.Views.Games.OddOneOutPage"
             x:DataType="viewmodels:OddOneOutViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource DarkSurface}">

    <ContentPage.Resources>
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#22FFFFFF" />
            <Setter Property="Stroke" Value="#33FFFFFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="16" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#11FFFFFF" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderColor" Value="#33FFFFFF" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="Padding" Value="16,24" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- Background Gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#06D6A0" Offset="0"/>
                    <GradientStop Color="#0EE9B0" Offset="1"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Decorative circles -->
        <Ellipse WidthRequest="200" HeightRequest="200"
                 HorizontalOptions="End" VerticalOptions="Start"
                 Margin="0,-50,-60,0" Opacity="0.1">
            <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
        </Ellipse>

        <Grid RowDefinitions="Auto, *">
            
            <!-- Top Bar / HUD -->
            <VerticalStackLayout Grid.Row="0" Spacing="16" Padding="20,40,20,10">
                <Grid ColumnDefinitions="Auto, *">
                    <Button Grid.Column="0" Text="←" FontSize="20" FontAttributes="Bold"
                            BackgroundColor="#22FFFFFF" TextColor="White"
                            CornerRadius="12" WidthRequest="44" HeightRequest="44"
                            Clicked="OnBackClicked"/>
                    <Label Grid.Column="1" Text="Odd One Out" TextColor="White" 
                           FontSize="20" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource GlassCardStyle}" Padding="12,8">
                        <VerticalStackLayout>
                            <Label Text="Score" TextColor="#B0B0CC" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="{Binding Score}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="12,8">
                        <VerticalStackLayout>
                            <Label Text="Round" TextColor="#B0B0CC" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="{Binding Round, StringFormat='{0}/10'}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="12,8">
                        <VerticalStackLayout>
                            <Label Text="Streak" TextColor="#B0B0CC" FontSize="12" HorizontalOptions="Center"/>
                            <Label Text="{Binding Streak}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar Progress="{Binding RoundProgress}" BackgroundColor="#33FFFFFF" ProgressColor="#FFB347" HeightRequest="6"/>
            </VerticalStackLayout>

            <!-- Game Content -->
            <VerticalStackLayout Grid.Row="1" Spacing="24" Padding="20,10,20,40" VerticalOptions="Center">
                
                <!-- Question Card -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="24,32">
                    <VerticalStackLayout Spacing="24">
                        <Label Text="{Binding CurrentQuestion.QuestionText}" 
                               TextColor="White" FontSize="22" FontAttributes="Bold" 
                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        
                        <controls:RingTimerControl HeightRequest="80" WidthRequest="80" 
                                                   HorizontalOptions="Center"
                                                   MaxTime="{Binding MaxTime}"
                                                   TimeLeft="{Binding TimeLeft}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 2x2 Options Grid -->
                <Grid x:Name="OptionsGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="16">
                    <!-- Buttons will be populated from code-behind so we can easily animate and color them -->
                </Grid>

            </VerticalStackLayout>

        </Grid>

        <!-- Result Overlay -->
        <Grid IsVisible="{Binding IsGameOver}" BackgroundColor="#B3000000">
            <Border Style="{StaticResource GlassCardStyle}" Margin="40" Padding="30" VerticalOptions="Center">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Game Over!" TextColor="White" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="{Binding Score, StringFormat='Score: {0}'}" TextColor="#06D6A0" FontSize="36" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Streak" TextColor="#B0B0CC" FontSize="14" HorizontalOptions="Center"/>
                            <Label Text="{Binding Streak}" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Border Stroke="#06D6A0" StrokeThickness="2" StrokeShape="RoundRectangle 12" BackgroundColor="#2206D6A0" Margin="0,10,0,0">
                        <Button Text="Play Again" TextColor="White" FontSize="16" FontAttributes="Bold" BackgroundColor="Transparent" Command="{Binding RestartGameCommand}" Padding="0,14" Clicked="OnPlayAgainClicked"/>
                    </Border>
                    <Button Text="Back to Menu" TextColor="#B0B0CC" FontSize="14" BackgroundColor="Transparent" Clicked="OnBackClicked"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
