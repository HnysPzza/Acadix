<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="AcadsJulie.Views.StatsPage"
             BackgroundColor="{StaticResource PageBackground}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header -->
            <Grid HeightRequest="130">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource GradStart}" Offset="0"/>
                            <GradientStop Color="{StaticResource GradEnd}" Offset="1"/>
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <Ellipse WidthRequest="120" HeightRequest="120"
                         HorizontalOptions="End" VerticalOptions="Start"
                         Margin="0,-20,-30,0" Opacity="0.12">
                    <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
                </Ellipse>
                <VerticalStackLayout Padding="24,50,24,20" Spacing="2" VerticalOptions="Start">
                    <Label Text="📊 Progress Dashboard"
                           TextColor="White"
                           FontSize="24"
                           FontAttributes="Bold"/>
                    <Label Text="Track your brain training journey"
                           TextColor="White"
                           FontSize="13"
                           Opacity="0.8"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Brain Score Card -->
            <Frame Margin="16,16,16,0"
                   Padding="20"
                   CornerRadius="20"
                   BackgroundColor="{StaticResource MobileSurface}"
                   Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=8}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout>
                        <Label Text="Overall Brain Score" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" HorizontalOptions="FillAndExpand"/>
                        <Label x:Name="BrainScoreLabel" Text="0" FontSize="28" FontAttributes="Bold">
                            <Label.TextColor><Color>#4361EE</Color></Label.TextColor>
                        </Label>
                    </HorizontalStackLayout>
                    <ProgressBar x:Name="BrainScoreProgress" Progress="0" ProgressColor="#4361EE"/>
                    <Label x:Name="BrainScoreSubtitle" Text="Keep training to improve your score!"
                           FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Per-Category Progress -->
            <Label Text="Category Breakdown"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="20,20,20,8"/>

            <Frame Margin="16,0,16,0"
                   Padding="20,16"
                   CornerRadius="20"
                   BackgroundColor="{StaticResource MobileSurface}"
                   Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=8}">
                <VerticalStackLayout Spacing="16">

                    <!-- Memory -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout>
                            <Label Text="🧠 Memory" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="FillAndExpand"/>
                            <Label x:Name="MemoryScoreLabel" Text="0" FontSize="14" FontAttributes="Bold">
                                <Label.TextColor><Color>#4361EE</Color></Label.TextColor>
                            </Label>
                        </HorizontalStackLayout>
                        <ProgressBar x:Name="MemoryProgress" Progress="0" ProgressColor="#4361EE"/>
                        <Label x:Name="MemoryHitRateLabel" Text="Hit Rate: 0%" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="End"/>
                    </VerticalStackLayout>

                    <BoxView BackgroundColor="{StaticResource Gray100}" HeightRequest="1"/>

                    <!-- Focus -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout>
                            <Label Text="🎯 Focus" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="FillAndExpand"/>
                            <Label x:Name="FocusScoreLabel" Text="0" FontSize="14" FontAttributes="Bold">
                                <Label.TextColor><Color>#06D6A0</Color></Label.TextColor>
                            </Label>
                        </HorizontalStackLayout>
                        <ProgressBar x:Name="FocusProgress" Progress="0" ProgressColor="#06D6A0"/>
                    </VerticalStackLayout>

                    <BoxView BackgroundColor="{StaticResource Gray100}" HeightRequest="1"/>

                    <!-- Logic -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout>
                            <Label Text="🧩 Logic" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="FillAndExpand"/>
                            <Label x:Name="LogicScoreLabel" Text="0" FontSize="14" FontAttributes="Bold">
                                <Label.TextColor><Color>#9D4EDD</Color></Label.TextColor>
                            </Label>
                        </HorizontalStackLayout>
                        <ProgressBar x:Name="LogicProgress" Progress="0" ProgressColor="#9D4EDD"/>
                    </VerticalStackLayout>

                    <BoxView BackgroundColor="{StaticResource Gray100}" HeightRequest="1"/>

                    <!-- Speed -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout>
                            <Label Text="⚡ Speed" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="FillAndExpand"/>
                            <Label x:Name="SpeedScoreLabel" Text="0" FontSize="14" FontAttributes="Bold">
                                <Label.TextColor><Color>#FF9A3C</Color></Label.TextColor>
                            </Label>
                        </HorizontalStackLayout>
                        <ProgressBar x:Name="SpeedProgress" Progress="0" ProgressColor="#FF9A3C"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- 30-Day Score History Chart (SkiaSharp) -->
            <Label Text="Score History (30 Days)"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="20,20,20,8"/>

            <Frame Margin="16,0,16,0"
                   Padding="16"
                   CornerRadius="20"
                   BackgroundColor="{StaticResource MobileSurface}"
                   Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=8}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Total score earned each day"
                           FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                    <skia:SKCanvasView x:Name="HistoryLineChart"
                                       HeightRequest="180"
                                       PaintSurface="OnDrawHistoryChart"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Weekly Activity Chart (SkiaSharp) -->
            <Label Text="Weekly Activity"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="20,20,20,8"/>

            <Frame Margin="16,0,16,0"
                   Padding="16"
                   CornerRadius="20"
                   BackgroundColor="{StaticResource MobileSurface}"
                   Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=8}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Games played per day (last 7 days)"
                           FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                    <skia:SKCanvasView x:Name="WeeklyBarChart"
                                       HeightRequest="160"
                                       PaintSurface="OnDrawWeeklyChart"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Trivia Mastery Chart -->
            <Label Text="Knowledge Mastery"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="20,20,20,8"/>

            <Frame Margin="16,0,16,0"
                   Padding="16"
                   CornerRadius="20"
                   BackgroundColor="{StaticResource MobileSurface}"
                   Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=8}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Best score per Trivia category"
                           FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                    <skia:SKCanvasView x:Name="TriviaChart"
                                       HeightRequest="200"
                                       PaintSurface="OnDrawTriviaChart"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Skill Radar Chart (SkiaSharp) -->
            <Label Text="Skill Balance"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="20,20,20,8"/>

            <Frame Margin="16,0,16,24"
                   Padding="16"
                   CornerRadius="20"
                   BackgroundColor="{StaticResource MobileSurface}"
                   Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=8}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Radar view of your skill distribution"
                           FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                    <skia:SKCanvasView x:Name="RadarChart"
                                       HeightRequest="220"
                                       PaintSurface="OnDrawRadarChart"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
