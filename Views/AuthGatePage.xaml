<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcadsJulie.Views.AuthGatePage"
             BackgroundColor="{StaticResource MobilePrimaryDark}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="28">
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource MobilePrimaryDark}" Offset="0"/>
                    <GradientStop Color="{StaticResource MobilePrimary}" Offset="0.62"/>
                    <GradientStop Color="{StaticResource MobileInk}" Offset="1"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <VerticalStackLayout Spacing="22"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <Border WidthRequest="82"
                    HeightRequest="82"
                    StrokeShape="RoundRectangle 26"
                    StrokeThickness="1"
                    Stroke="#55FFFFFF"
                    BackgroundColor="#22FFFFFF">
                <Grid>
                    <Label Text="A"
                           FontSize="38"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <BoxView HeightRequest="5"
                             WidthRequest="34"
                             CornerRadius="3"
                             BackgroundColor="{StaticResource MobileAmber}"
                             HorizontalOptions="Center"
                             VerticalOptions="End"
                             Margin="0,0,0,17"/>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="Acadix"
                       TextColor="White"
                       FontSize="34"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="Checking your learning profile"
                       TextColor="#DDF7FBF8"
                       FontSize="14"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="True"
                               Color="{StaticResource MobileAmber}"
                               WidthRequest="38"
                               HeightRequest="38"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
