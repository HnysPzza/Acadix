<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcadsJulie.Views.EditProfilePage"
             BackgroundColor="{StaticResource MobileCanvas}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,40,20,20" BackgroundColor="{StaticResource MobilePrimaryDark}">
            <Button Grid.Column="0" Text="←" FontSize="20" FontAttributes="Bold"
                    BackgroundColor="#22FFFFFF" TextColor="White"
                    CornerRadius="18" WidthRequest="44" HeightRequest="44"
                    Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="Edit Profile" TextColor="White" 
                   FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="Save" FontSize="16" FontAttributes="Bold"
                    BackgroundColor="Transparent" TextColor="White"
                    Clicked="OnSaveClicked"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="32">
                
                <!-- Avatar Section -->
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Frame WidthRequest="120" HeightRequest="120"
                           CornerRadius="60"
                           BackgroundColor="{StaticResource MobilePrimaryMuted}"
                           Padding="0"
                           IsClippedToBounds="True"
                           HorizontalOptions="Center"
                           BorderColor="{StaticResource MobilePrimary}">
                        <Grid>
                            <Label x:Name="AvatarLabel"
                                   Text="BT"
                                   FontSize="40"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource MobilePrimary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Image x:Name="AvatarImage"
                                   Aspect="AspectFill"
                                   IsVisible="False"/>
                        </Grid>
                    </Frame>
                    <Button Text="Change Photo" TextColor="{StaticResource MobilePrimary}" BackgroundColor="Transparent" FontSize="16" FontAttributes="Bold" Clicked="OnChangePhotoClicked"/>
                </VerticalStackLayout>

                <!-- Form Section -->
                <VerticalStackLayout Spacing="24">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Display Name" TextColor="{StaticResource TextSecondary}" FontSize="14" FontAttributes="Bold"/>
                        <Frame Padding="16,4" CornerRadius="18" BorderColor="{StaticResource MobileStroke}" BackgroundColor="{StaticResource MobileSurfaceRaised}">
                            <Entry x:Name="NameEntry" Placeholder="Enter your name" TextColor="{StaticResource TextPrimary}" FontSize="16" MaxLength="30"/>
                        </Frame>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
