<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AcadsJulie.Models"
             x:Class="AcadsJulie.Views.DailyQuestsPage"
             BackgroundColor="{StaticResource MobileCanvas}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Header Section -->
        <Grid Grid.Row="0"
              HeightRequest="220"
              VerticalOptions="Start">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource MobilePrimaryDark}" Offset="0"/>
                        <GradientStop Color="{StaticResource MobilePrimary}" Offset="1"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Ellipse WidthRequest="200" HeightRequest="200"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-50,-50,0" Opacity="0.1"
                     Fill="White" />
                     
            <Ellipse WidthRequest="100" HeightRequest="100"
                     HorizontalOptions="Start" VerticalOptions="End"
                     Margin="-20,0,0,-20" Opacity="0.1"
                     Fill="White" />

            <VerticalStackLayout Padding="24,50,24,0" Spacing="8">
                <Label Text="Daily Quests"
                       TextColor="White"
                       FontSize="28"
                       FontAttributes="Bold" />
                <Label Text="Complete these challenges before midnight to earn bonus XP!"
                       TextColor="White"
                       FontSize="14"
                       Opacity="0.9" />
            </VerticalStackLayout>
        </Grid>

        <!-- Quests List Section -->
        <CollectionView x:Name="QuestsList"
                        Grid.Row="1"
                        Margin="16,-40,16,0"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DailyQuest">
                    <Border Margin="0,0,0,16"
                            Padding="16"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource MobileSurface}"
                            Stroke="{StaticResource MobileStroke}"
                            StrokeThickness="1">
                        
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            
                            <!-- Quest Title & XP -->
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Border Padding="8,4"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource MobilePrimaryMuted}"
                                        Stroke="Transparent">
                                    <Label Text="{Binding RewardXP, StringFormat='+{0} XP'}"
                                           TextColor="{StaticResource MobilePrimaryDark}"
                                           FontSize="12"
                                           FontAttributes="Bold"/>
                                </Border>
                            </HorizontalStackLayout>
                            
                            <!-- Description -->
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding Description}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   Margin="0,4,0,12" />
                            
                            <!-- Progress Bar & Text -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <ProgressBar Progress="{Binding ProgressPercent}"
                                             ProgressColor="{StaticResource MobilePrimary}"
                                             HeightRequest="8"/>
                                <Label FontSize="12" TextColor="{StaticResource TextMuted}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} / {1}">
                                            <Binding Path="CurrentAmount" />
                                            <Binding Path="TargetAmount" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                            
                            <!-- Claim Button -->
                            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                    Text="Claim"
                                    FontAttributes="Bold"
                                    BackgroundColor="{StaticResource MobilePrimary}"
                                    TextColor="White"
                                    CornerRadius="18"
                                    HeightRequest="40"
                                    Padding="16,0"
                                    VerticalOptions="Center"
                                    Margin="12,0,0,0"
                                    IsVisible="{Binding IsCompleted}"
                                    Clicked="OnClaimRewardClicked"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsClaimed}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Text" Value="Claimed" />
                                        <Setter Property="BackgroundColor" Value="{StaticResource MobileSurfaceSunken}" />
                                        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
