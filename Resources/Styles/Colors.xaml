<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
    ==========================================================================
     ACADIX COLOR SYSTEM  ·  START HERE
    ==========================================================================

     THREE BRAND COLOURS. Everything else is a neutral or a state signal.

       1. PRIMARY   #0F766E  teal    · actions, navigation, brand identity
       2. ACCENT    #F9735B  coral   · streaks, rewards, highlights
       3. INK       #121A1C          · text and dark surfaces

     Plus NEUTRALS (canvas / surface / stroke) and two STATE colours
     (success / danger). State colours are not "brand" colours   they are
     feedback signals, and collapsing them into the brand palette would make
     an error look identical to a success.

     RULES
       · Use a token. Never paste a raw hex into a page.
       · Primary appears at most twice per screen. Overuse kills an accent.
       · On LIGHT backgrounds, use the *OnLight text variants   the vivid
         brand colours fail WCAG contrast as small text (measured below).
       · On DARK game screens the vivid originals are correct and already
         pass at 5:1 to 9:1. Do not "fix" those.

     WHY THIS EXISTS
       An audit found 205 colour values: 9 different greens for "success",
       9 reds for "error", 8 ambers for "warning", and 3 token names
       (MobileCanvas / SurfaceAlt / PageBackground) all resolving to the same
       #EAF2EE. Pages drifted because there was no single source of truth.
    ==========================================================================
    -->

    <!-- 1 · PRIMARY ........................................................ -->
    <Color x:Key="Brand">#0F766E</Color>
    <Color x:Key="BrandDark">#134E4A</Color>
    <Color x:Key="BrandMuted">#D8F3EC</Color>

    <!-- 2 · ACCENT ......................................................... -->
    <Color x:Key="Accent">#F9735B</Color>
    <Color x:Key="AccentOnLight">#B23A22</Color>
    <Color x:Key="AccentMuted">#FFE4D9</Color>

    <!-- 3 · INK ............................................................ -->
    <Color x:Key="Ink">#121A1C</Color>
    <Color x:Key="InkSoft">#59686A</Color>
    <Color x:Key="InkMuted">#6E7D80</Color>

    <!-- NEUTRALS ........................................................... -->
    <Color x:Key="Canvas">#EAF2EE</Color>
    <Color x:Key="CanvasDeep">#DDEAE5</Color>
    <Color x:Key="SurfaceBase">#F7FBF8</Color>
    <Color x:Key="SurfaceRaised">#EEF7F3</Color>
    <Color x:Key="Stroke">#C7D7D2</Color>
    <Color x:Key="Divider">#D9E5E0</Color>

    <!-- STATE · fills and dark-background text ............................. -->
    <Color x:Key="StateSuccess">#16A34A</Color>
    <Color x:Key="StateDanger">#DC2626</Color>
    <Color x:Key="StateWarning">#F6A623</Color>

    <!-- STATE · small text on LIGHT backgrounds (all >= 4.5:1 on #EAF2EE) ... -->
    <Color x:Key="StateSuccessOnLight">#0F7434</Color>
    <Color x:Key="StateDangerOnLight">#B91C1C</Color>
    <Color x:Key="StateWarningOnLight">#8A5A00</Color>

    <!-- DARK SURFACES · game screens ....................................... -->
    <Color x:Key="DarkCanvas">#101427</Color>
    <Color x:Key="DarkSurface">#1A1A2E</Color>
    <Color x:Key="DarkTextMuted">#B0B0CC</Color>

    <!--
     LEGACY TOKENS BELOW
     Kept so existing pages keep compiling. Duplicates are aliased onto the
     canonical values above, so the three redundant background names now
     genuinely point at one colour. Prefer the tokens above in new code.
    -->

    <!-- Primary Brand Colors -->
    <Color x:Key="BrainBlue">#4361EE</Color>
    <Color x:Key="BrainPurple">#7B2FBE</Color>
    <Color x:Key="BrainPurpleLight">#9D4EDD</Color>
    <Color x:Key="BrainDeepBlue">#2B2D8A</Color>
    <Color x:Key="BrainBlueMid">#3A86FF</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentGreen">#06D6A0</Color>
    <Color x:Key="AccentGreenLight">#0EE9B0</Color>
    <Color x:Key="AccentOrange">#FF9A3C</Color>
    <Color x:Key="AccentOrangeLight">#FFB347</Color>
    <Color x:Key="AccentPink">#FF4D6D</Color>
    <Color x:Key="AccentYellow">#FFD166</Color>

    <!-- Category Colors -->
    <Color x:Key="MemoryColor">#4361EE</Color>
    <Color x:Key="FocusColor">#06D6A0</Color>
    <Color x:Key="LogicColor">#9D4EDD</Color>
    <Color x:Key="SpeedColor">#FF9A3C</Color>

    <!-- Background Colors -->
    <Color x:Key="MobileCanvas">#EAF2EE</Color>
    <Color x:Key="MobileCanvasDeep">#DDEAE5</Color>
    <Color x:Key="MobileSurface">#F7FBF8</Color>
    <Color x:Key="MobileSurfaceRaised">#EEF7F3</Color>
    <Color x:Key="MobileSurfaceSunken">#DDE9E5</Color>
    <Color x:Key="MobileInk">#121A1C</Color>
    <Color x:Key="MobilePrimary">#0F766E</Color>
    <Color x:Key="MobilePrimaryDark">#134E4A</Color>
    <Color x:Key="MobilePrimaryMuted">#D8F3EC</Color>
    <Color x:Key="MobileCoral">#F9735B</Color>
    <Color x:Key="MobileCoralMuted">#FFE4D9</Color>
    <Color x:Key="MobileAmber">#F6A623</Color>
    <Color x:Key="MobileAmberMuted">#FFF0C2</Color>
    <Color x:Key="MobileIndigo">#4856D6</Color>
    <Color x:Key="MobileIndigoMuted">#E4E8FF</Color>
    <Color x:Key="MobileSuccess">#16A34A</Color>
    <Color x:Key="MobileSuccessMuted">#DDF8EC</Color>
    <Color x:Key="MobileStroke">#C7D7D2</Color>
    <Color x:Key="MobileDivider">#D9E5E0</Color>
    <Color x:Key="MobileTabMuted">#8EA09B</Color>
    <Color x:Key="PageBackground">#EAF2EE</Color>
    <Color x:Key="CardBackground">#F7FBF8</Color>
    <Color x:Key="GlassBackground">#CCF7FBF8</Color>
    <Color x:Key="DarkBackground">#0D0D1A</Color>
    <Color x:Key="DarkCard">#1A1A2E</Color>
    <Color x:Key="DarkCardAlt">#16213E</Color>
    <Color x:Key="SurfaceLight">#F5F5FF</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#121A1C</Color>
    <Color x:Key="TextSecondary">#59686A</Color>
    <Color x:Key="TextMuted">#7E8D90</Color>
    <Color x:Key="TextLight">#F9FAFB</Color>
    <Color x:Key="TextOnDark">#E2E8F0</Color>

    <!--
        Accessible text variants (WCAG AA, >=4.5:1 on MobileCanvas #EAF2EE).

        The brand amber/coral/success colours are tuned for FILLS and STROKES, where contrast
        rules do not apply. Used as small text on the light canvas they fail badly:
            MobileAmber   #F6A623 -> 1.77:1   (needs 4.5)
            MobileCoral   #F9735B -> 2.42:1
            MobileSuccess #16A34A -> 2.89:1
        These darker variants keep the same hue but pass. Use *OnLight tokens whenever the
        colour is applied to TextColor over a light background; keep the originals for fills.
    -->
    <Color x:Key="MobileAmberOnLight">#8A5A00</Color>    <!-- 6.42:1 -->
    <Color x:Key="MobileCoralOnLight">#B23A22</Color>    <!-- 5.24:1 -->
    <Color x:Key="MobileSuccessOnLight">#0F7434</Color>  <!-- 5.13:1 -->

    <!-- Gradient Stops -->
    <Color x:Key="GradStart">#134E4A</Color>
    <Color x:Key="GradMid">#0F766E</Color>
    <Color x:Key="GradEnd">#4856D6</Color>

    <!-- Semantic Tokens -->
    <Color x:Key="Surface">#F7FBF8</Color>
    <Color x:Key="SurfaceAlt">#EAF2EE</Color>
    <Color x:Key="BrandPrimary">#0F766E</Color>
    <Color x:Key="BrandAccent">#F9735B</Color>
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="CardStroke">#C7D7D2</Color>
    <Color x:Key="GlassFill">#88F7FBF8</Color>

    <!-- Legacy (kept for Styles.xaml compatibility) -->
    <Color x:Key="Primary">#4361EE</Color>
    <Color x:Key="PrimaryDark">#2B2D8A</Color>
    <Color x:Key="PrimaryDarkText">#E2E8F0</Color>
    <Color x:Key="Secondary">#9D4EDD</Color>
    <Color x:Key="SecondaryDarkText">#7B2FBE</Color>
    <Color x:Key="Tertiary">#06D6A0</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#FF4D6D</Color>
    <Color x:Key="MidnightBlue">#0D0D1A</Color>
    <Color x:Key="OffBlack">#1A1A2E</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
