rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// The client is not trusted. Anyone can repackage the APK and post whatever they like, so
// these rules validate the shape AND the plausibility of every leaderboard field, rather than
// only checking who is writing.

service cloud.firestore {
  match /databases/{database}/documents {

    match /leaderboards/global/users/{userId} {

      // Signed-in users can read the leaderboard. The document intentionally contains no
      // email address or other contact detail — only a display name and public scores.
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && isValidEntry();

      // Owners may remove their own entry — required so "Delete my account" can clean up
      // the leaderboard before the Firebase account goes away. Nobody can delete anyone else's.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function data() {
  return request.resource.data;
}

function isValidEntry() {
  return data().keys().hasOnly([
           'uid', 'displayName', 'brainScore', 'level',
           'xp', 'streakDays', 'gamesPlayed', 'triviaBestScore', 'updatedAt'
         ])
         && data().keys().hasAll([
              'uid', 'displayName', 'brainScore', 'level',
              'xp', 'streakDays', 'gamesPlayed', 'triviaBestScore', 'updatedAt'
            ])

         // Identity must match the document path.
         && data().uid is string
         && data().uid == request.auth.uid

         // Display name: present, not abusive in length.
         && data().displayName is string
         && data().displayName.size() > 0
         && data().displayName.size() <= 40

         // Scores must be integers inside believable ranges. BrainScore is an average of four
         // category scores that the app caps well below 10000.
         && data().brainScore is int
         && data().brainScore >= 0 && data().brainScore <= 10000

         && data().level is int
         && data().level >= 1 && data().level <= 1000

         && data().xp is int
         && data().xp >= 0 && data().xp <= 10000000

         && data().streakDays is int
         && data().streakDays >= 0 && data().streakDays <= 3650

         && data().gamesPlayed is int
         && data().gamesPlayed >= 0 && data().gamesPlayed <= 1000000

         && data().triviaBestScore is int
         && data().triviaBestScore >= 0 && data().triviaBestScore <= 100000

         // The REST client sends its own clock (a plain document PATCH cannot carry a
         // serverTimestamp sentinel), so we allow only a small skew window around server time.
         // That still blocks the backdating/forward-dating tricks used to game "recent" sorts.
         && data().updatedAt is timestamp
         && data().updatedAt <= request.time + duration.value(5, 'm')
         && data().updatedAt >= request.time - duration.value(15, 'm');
}
